n 2; }\n    uint64_t N = strtoull(argv[1], NULL, 10);\n    if (N < 1 || N > 100000000000ULL) { fprintf(stderr, \"N out of range\\n\"); return 2; }\n\n    uint64_t verified = 0;\n    uint64_t max_steps = 0, argmax_steps = 0;\n    uint64_t max_peak  = 0, argmax_peak  = 0;\n    uint64_t sum_steps = 0;\n    uint64_t cap_hits = 0, overflow_trips = 0;\n\n    for (uint64_t n = 1; n <= N; n++) {\n        uint64_t m = n, steps = 0, peak = n;\n        /* P(1) trivially true; for n>=2 iterate until below n or hit 1 */\n        while (m >= n && m != 1) {\n            if (m & 1ULL) {\n                if (m > OVERFLOW_LIMIT / 3) { overflow_trips++; goto fail; }\n                m = 3*m + 1;\n            } else {\n                m >>= 1;\n            }\n            if (m > peak) peak = m;\n            steps++;\n            if (steps > MAX_STEPS) { cap_hits++; goto fail; }\n        }\n        /* P(n) established: either m==1, or m<n and P(m) holds by induction */\n        verified++;\n        sum_steps += steps;\n        if (steps > max_steps) { max_steps = steps; argmax_steps = n; }\n        if (peak  > max_peak ) { max_peak  = peak;  argmax_peak  = n; }\n        if (n % 1000000ULL == 0) fprintf(stderr, \"progress: %10\" PRIu64 \" verified\\n\", n);\n        continue;\n    fail:\n        fprintf(stderr, \"FAILURE at n=%\" PRIu64 \" (m=%\" PRIu64 \", steps=%\" PRIu64 \")\\n\", n, m, steps);\n        printf(\"RESULT FAILURE n=%\" PRIu64 \"\\n\", n);\n        return 1;\n    }\n\n    printf(\"RESULT SUCCESS\\n\");\n    printf(\"N=%\" PRIu64 \"\\n\", N);\n    printf(\"verified_count=%\" PRIu64 \"\\n\", verified);\n    printf(\"max_total_stopping_time=%\" PRIu64 \"\\n\", max_steps);\n    printf(\"argmax_total_stopping_time=%\" PRIu64 \"\\n\", argmax_steps);\n    printf(\"max_peak=%\" PRIu64 \"\\n\", max_peak);\n    printf(\"argmax_peak=%\" PRIu64 \"\\n\", argmax_peak);\n    printf(\"sum_stopping_time_frontier=%\" PRIu64 \"\\n\", sum_steps);\n    printf(\"cap_hits=%\" PRIu64 \"\\n\", cap_hits);\n    printf(\"overflow_trips=%\" PRIu64 \"\\n\", overflow_trips);\n    return 0;\n}\n```\n\nWait, careful with the loop condition `while (m >= n && m != 1)`. For n=1: m=1 → loop doesn't execute (m==1). steps=0, peak=1. P(1) trivially. Good. For n=2: m=2 ≥ 2, m≠1 → m=1, steps=1, peak=2; loop check: m==1 → exit. Good. Note: \"peak\" should include the starting value n and all trajectory values — I initialize peak=n and update after each step. Good.\n\nSubtle: `steps` here counts steps until dropping below n or hitting 1 — this is the \"frontier stopping time\", NOT the total stopping time σ∞(n). The max over n of this frontier-steps is a different stat than the classic \"total stopping time record\". For comparison with literature records (Wikipedia table lists total stopping time records, e.g. n=27 with 111 steps), I need σ∞. Hmm. Options: compute σ∞ in verifier B (memoized: σ∞(n) = 1 + σ∞(T(n)) with table), and in Python. For verifier A, frontier version is fine for the reach-1 claim. But for the literature cross-check (records table), I want σ∞ per n. Let me make verifier B compute σ∞ exactly with a memo table up to some size M (say 2^24 = 16.7M entries × 4 bytes = 64MB — fine; or 2^25=128MB, fine too; use 2^25? 32M entries × uint32 = 128MB. Let's use 2^24=64MB to be safe, and for trajectory values above the table but below n... hmm, σ∞ via memo: iterate m = T^k(n) until m ≤ table_limit AND σ∞(m) known, or m < n... no — simplest: table stores σ∞ for all m ≤ table_limit, computed bottom-up from 1 (σ∞(1)=0; σ∞(m) = 1 + σ∞(T(m)) where T(m) may exceed table_limit — then need to iterate until re-entering the table). Standard approach: for m from 2 to table_limit: iterate trajectory, counting steps, until hitting a value j ≤ table_limit with known σ∞ (all values < m are known if we go in order AND T(m) < m... not true: T(m)=3m+1 > m for odd m. So when computing σ∞(m) for odd m, T(m)=3m+1 > m is unknown yet. Iterate: m' = 3m+1 (even) → (3m+1)/2... keep stepping u