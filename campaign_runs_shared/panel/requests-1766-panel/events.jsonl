{"ts": 1793694888.669, "kind": "tool_start", "step": 12, "tool": "run_command", "blast": "execute", "args": {"cmd": "C:/Users/agent/work/projects/stack/campaign/.venv/bin/python - <<'EOF'\nimport sys, types\n# In-memory shim for the missing backports fallback (Python 3.12 removed ssl.match_hostname).\n# Nothing is written to the repo.\nssl_mod = types.ModuleType('backports.ssl_match_hostname')\nimport ssl as _ssl\nssl_mod.CertificateError = getattr(_ssl, 'CertificateError', type('CertificateError', (Exception,), {}))\ndef match_hostname(cert, hostname):\n    # minimal behavior for import-time only; not used by this check\n    return None\nssl_mod.match_hostname = match_hostname\nbackports = types.ModuleType('backports')\nbackports.ssl_match_hostname = ssl_mod\nsys.modules['backports'] = backports\nsys.modules['backports.ssl_match_hostname'] = ssl_mod\n\nimport requests\nfrom requests.auth import HTTPDigestAuth\n\na = HTTPDigestAuth('user', 'pass')\na.chal = {'realm': 'test', 'nonce': 'abc123', 'qop': 'auth'}\nhdr = a.build_digest_header('GET', 'http://example.com/digest-auth')\nprint(hdr)\nimport re\nm = re.search(r'qop=\"?auth\"?,', hdr)\nprint('qop quoted:', '\"qop=\\\\\"auth\\\\\"\"' in hdr or 'qop=\"auth\"' in hdr)\nassert 'qop=\"auth\"' in hdr, 'qop not quoted!'\n# also check qop=None path still works (no qop in header)\na2 = HTTPDigestAuth('user', 'pass')\na2.chal = {'realm': 'test', 'nonce': 'abc123'}\nhdr2 = a2.build_digest_header('GET', 'http://example.com/digest-auth')\nprint(hdr2)\nassert 'qop' not in hdr2\nprint('OK: qop quoted when present, absent when challenge has no qop')\nEOF"}}
