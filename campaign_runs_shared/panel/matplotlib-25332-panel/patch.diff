@@ -788,6 +788,24 @@ class Grouper:
     def __init__(self, init=()):
         self._mapping = {weakref.ref(x): [weakref.ref(x)] for x in init}
 
+    def __getstate__(self):
+        # weakrefs cannot be pickled; store the dereferenced objects
+        # (de-duplicated by group identity) and recreate the weakrefs in
+        # __setstate__.
+        self.clean()
+        return [
+            [x() for x in group]
+            for group in {id(group): group
+                          for group in self._mapping.values()}.values()
+        ]
+
+    def __setstate__(self, state):
+        self._mapping = {}
+        for group in state:
+            refs = [weakref.ref(x) for x in group]
+            for ref in refs:
+                self._mapping[ref] = refs
+
     def __contains__(self, item):
         return weakref.ref(item) in self._mapping
 
