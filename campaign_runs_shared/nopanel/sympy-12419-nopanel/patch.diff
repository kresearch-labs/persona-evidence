+def test_Identity_symbolic_entry():
+    # issue 12419: Identity(n)[i, j] with symbolic indices must not
+    # evaluate to 0; it should give a KroneckerDelta bounded by the
+    # matrix shape so that sums over its elements evaluate correctly.
+    i, j = symbols('i j', integer=True)
+    In = Identity(n)
+    assert In[i, j] == KroneckerDelta(i, j, (0, n - 1))
+    assert In[0, 0] == 1
+    assert In[0, 1] == 0
+    assert Sum(In[i, j], (i, 0, n - 1)).doit() == 1
+    assert Sum(Sum(In[i, j], (i, 0, n - 1)), (j, 0, n - 1)).doit() == n
+
+
