     assert safe_isclass(CrappyClass()) is False
+    assert safe_isclass(CrappyClass()) is False
+
+
+def test_num_mock_patch_args_with_numpy(testdir):
+    """#5631: patch(..., new=numpy.array(...)) must not raise ValueError
+    during collection (array __eq__ returns an array, not a bool)."""
+    pytest.importorskip("numpy")
+    testdir.makepyfile(
+        """
+        from unittest.mock import patch
+        import numpy
+
+        @patch("os.path.join", new=numpy.array([1, 2]))
+        def test_nopatch_with_string():
+            pass
+    """
+    )
+    # --assert=plain: assertion rewriting of the temp file is unrelated here
+    result = testdir.runpytest("--assert=plain")
+    result.stdout.fnmatch_lines(["*1 passed*"])
